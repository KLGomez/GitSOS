---
interface Props {
  marketplaceUrl: string;
  openVsxUrl?: string;
}

const { marketplaceUrl, openVsxUrl } = Astro.props;
---

<section
  aria-labelledby="vscode-extension-heading"
  class="col-span-1 md:col-span-2 p-6 md:p-8 rounded-xl border border-slate-800 bg-slate-900/60 backdrop-blur-sm shadow-lg"
>
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
    <div class="lg:col-span-7 flex flex-col items-start">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500/10 border border-indigo-500/25 text-indigo-300 text-xs font-semibold mb-3">
        <span class="w-1.5 h-1.5 rounded-full bg-indigo-400"></span>
        <span>Extensión para VS Code • Gratuita</span>
      </div>

      <h2 id="vscode-extension-heading" class="text-xl md:text-2xl font-bold text-white mb-3">
        Llevá GitSOS directo a tu editor
      </h2>

      <p class="text-slate-300 text-sm md:text-base leading-relaxed mb-3">
        Consultá las situaciones más comunes de Git sin salir de Visual Studio Code. Incluye un panel lateral 100% offline con buscador, explicación simple paso a paso, asistente guiado para Conventional Commits y confirmación segura antes de ejecutar acciones delicadas.
      </p>

      <p class="text-xs sm:text-sm text-slate-400 leading-relaxed mb-5">
        Es completamente gratuita, de código abierto y está pensada especialmente para quienes recién empiezan con Git y GitHub.
      </p>

      <div class="flex flex-col sm:flex-row flex-wrap items-stretch sm:items-center gap-3 w-full sm:w-auto">
        <a
          href={marketplaceUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-indigo-600 hover:bg-indigo-500 text-white font-medium px-5 py-3 rounded-lg transition-all shadow-md shadow-indigo-950/30 no-underline"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <polyline points="7 10 12 15 17 10" />
            <line x1="12" y1="15" x2="12" y2="3" />
          </svg>
          <span>Instalar desde Marketplace</span>
        </a>

        {openVsxUrl && (
          <a
            href={openVsxUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 border border-slate-700 hover:border-indigo-400/60 bg-slate-800/60 hover:bg-slate-800 text-slate-200 hover:text-white font-medium px-4 py-3 rounded-lg transition-all no-underline text-sm"
          >
            <span>También en Open VSX</span>
          </a>
        )}
      </div>
    </div>

    <div class="lg:col-span-5">
      <div class="rounded-xl border border-slate-800 bg-slate-950/80 p-2 shadow-md max-w-sm mx-auto lg:max-w-none">
        <img
          src="/panel-lateral.png"
          alt="Captura real del panel lateral de la extensión GitSOS en Visual Studio Code mostrando buscador, filtros por categoría y tarjetas de situaciones"
          width="720"
          height="847"
          loading="lazy"
          class="w-full h-auto rounded-lg block"
        />
      </div>
    </div>
  </div>
</section>
