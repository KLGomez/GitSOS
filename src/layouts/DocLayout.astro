---
import '../styles/global.css';
import GitSOSInterface from '../components/GitSOSInterface.tsx';

const { frontmatter } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{frontmatter?.title ? `${frontmatter.title} - GitSOS` : 'GitSOS Docs'}</title>
  </head>
  <body class="bg-slate-950 m-0 p-0 text-slate-200">
    <GitSOSInterface client:load>
      <slot />
    </GitSOSInterface>

    <script is:inline>
      function attachCopyButtons() {
        const preElements = document.querySelectorAll('.prose pre');
        
        preElements.forEach((pre) => {
          if (pre.querySelector('.astro-copy-btn')) return;

          pre.classList.add('relative', 'group');

          const button = document.createElement('button');
          button.className = 'astro-copy-btn absolute top-2.5 right-2.5 z-10 p-1.5 rounded-md bg-slate-800/90 hover:bg-slate-700 text-slate-400 hover:text-white border border-slate-700/80 transition-all opacity-0 group-hover:opacity-100 focus:opacity-100 shadow-sm cursor-pointer flex items-center justify-center';
          button.setAttribute('aria-label', 'Copiar código al portapapeles');
          button.setAttribute('title', 'Copiar código');

          const copySvg = `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>`;
          const checkSvg = `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>`;

          button.innerHTML = copySvg;

          button.addEventListener('click', async () => {
            const code = pre.querySelector('code');
            const textToCopy = code ? code.innerText : pre.innerText;

            try {
              await navigator.clipboard.writeText(textToCopy.trim());
              button.innerHTML = checkSvg;
              setTimeout(() => {
                button.innerHTML = copySvg;
              }, 2000);
            } catch (err) {
              console.error('Error al copiar al portapapeles: ', err);
            }
          });

          pre.appendChild(button);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', attachCopyButtons);
      } else {
        attachCopyButtons();
      }
      document.addEventListener('astro:page-load', attachCopyButtons);
    </script>
  </body>
</html>
