# Google Gemini API Key para el Asistente IA de GitSOS
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here

# Feature flag para la sección de la extensión de VS Code en la web.
# Sin definir: apagada en producción/local y activa automáticamente cuando VERCEL_ENV=preview.
# Valores explícitos: "true" para mostrarla siempre, "false" para ocultarla incluso en preview.
# SHOW_VSCODE_EXTENSION=false

# URL pública de la extensión en Visual Studio Marketplace (opcional hasta publicar)
# VSCODE_MARKETPLACE_URL=https://marketplace.visualstudio.com/items?itemName=tu-publisher.gitsos
